# ---- large local datasets and derived rasters: deliberately NOT versioned ----
# The current 26-entry manifest is about 531 MB (507 MiB); restored bytes live
# in .cache/ and are re-derivable with `python3 scripts/restore_data.py --group all`.
# That command verifies each current entry against registry/data_manifest.json; no
# fixed restore duration is promised. The committed receipt covers only 23 entries.
.cache/
/data/*
!/data/README.md
!/data/restore_receipt.json
# session 3: provenance record for the reference corpus copied in from GEMSDOE1-46
!/data/reference/
/data/reference/*
!/data/reference/README.md
/artifacts/
/outputs/
work/
*.npz
*.npy
*.tiff
*.partial
*.assembling

# ---- session 3 scratch: rebuilt by scripts/, never versioned ----
/data/bridge/
/data/surfaces/
_preview/
evidence/sweep/sweep_a_quick.json
evidence/sweep/sweep_quick.json
evidence/sweep/sweep_a_prefix.json
evidence/sweep/sweep_a_b5.json
scratch/
*.log.tmp

# ---- the ONE derived artifact that must be versioned: the downloadable submission ----
!docs/downloads/*.tif

# ---- python ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
venv*/
.DS_Store
